# Модель: любой OpenAI-совместимый сервис.
# Для LM Studio: OPENAI_BASE_URL=http://localhost:1234/v1, OPENAI_API_KEY=lm-studio
OPENAI_BASE_URL=
OPENAI_API_KEY=
MODEL=

# Эмбеддинги для плотного поиска: любой сервис с /v1/embeddings. Пусто — только BM25.
# Модель лучше многоязычная (bge-m3, multilingual-e5), чтобы искать по-русски в английских статьях.
# В LM Studio: EMBED_MODEL=text-embedding-bge-m3 (скачать: lms get https://huggingface.co/ggml-org/bge-m3-Q8_0-GGUF),
# адрес и ключ можно не задавать — возьмутся OPENAI_*.
EMBED_MODEL=
EMBED_BASE_URL=
EMBED_API_KEY=

# Внешние источники (необязательно). Почта попадает в User-Agent и в параметр mailto для OpenAlex:
# так источники видят, кто к ним обращается, и реже ограничивают.
CONTACT_EMAIL=
OPENALEX_API_KEY=

# Пути и лимиты
DATA_DIR=data
RUNS_DIR=runs
MAX_STEPS=12
