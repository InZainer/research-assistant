# Скопируйте в .env и заполните. Файл .env не коммитится и не попадает в архивы проекта.

# --- Чат-модель агента: сторонний AI-сервис с OpenAI-совместимым API (нужен вызов инструментов) ---
# Выбор одной строкой: lmstudio, ollama, inception, openai, anthropic, openrouter, deepseek, gemini, custom.
# Состояние всех профилей: uv run research-assistant providers; проверка выбранного: uv run research-assistant check
# Разовый выбор для одной команды: uv run research-assistant --provider openrouter ask "..."
LLM_PROVIDER=lmstudio

# Ключи — под стандартными именами провайдеров (или LLM_<ИМЯ>_API_KEY). Нужны только для облачных.
INCEPTION_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=

# Модель провайдера: LLM_<ИМЯ>_MODEL. По умолчанию заданы только проверенные id:
# lmstudio — qwen3.5-4b, inception — mercury-3, anthropic — claude-sonnet-5-5, deepseek — deepseek-chat.
# Для openai, openrouter, ollama, gemini и custom модель обязательна. Она должна поддерживать tools.
LLM_LMSTUDIO_MODEL=qwen3.5-4b
LLM_INCEPTION_MODEL=mercury-3
LLM_OPENAI_MODEL=
LLM_ANTHROPIC_MODEL=
LLM_OPENROUTER_MODEL=
LLM_OLLAMA_MODEL=
LLM_DEEPSEEK_MODEL=
LLM_GEMINI_MODEL=

# Свой сервис (vLLM, llama.cpp server, прокси, корпоративный шлюз):
LLM_CUSTOM_BASE_URL=
LLM_CUSTOM_API_KEY=
LLM_CUSTOM_MODEL=

# Необязательно: другой адрес профиля (LLM_<ИМЯ>_BASE_URL) и reasoning_effort (LLM_<ИМЯ>_REASONING_EFFORT).
# Для Qwen3.5 в LM Studio по умолчанию none: так отключаются «размышления» на коротких шагах агента.
# LLM_LMSTUDIO_BASE_URL=http://192.168.1.10:1234/v1

# Старая схема без LLM_PROVIDER (поддерживается): OPENAI_BASE_URL, OPENAI_API_KEY, MODEL, REASONING_EFFORT.

# --- Эмбеддинги для поиска по смыслу ---
# Индекс библиотеки посчитан bge-m3: модель должна совпадать (иначе — заново research-assistant index).
# Для облачных провайдеров по умолчанию берётся LM Studio (http://localhost:1234/v1), для локальных — тот же сервер.
# Без эмбеддингов поиск работает по словам (BM25). Скачать модель: lms get https://huggingface.co/ggml-org/bge-m3-Q8_0-GGUF
EMBED_MODEL=text-embedding-bge-m3
EMBED_BASE_URL=
EMBED_API_KEY=

# --- Внешние источники статей (необязательно) ---
# Почта попадает в User-Agent и в параметр mailto для OpenAlex: так источники реже ограничивают.
CONTACT_EMAIL=
OPENALEX_API_KEY=

# --- Пути и лимиты ---
DATA_DIR=data
RUNS_DIR=runs
MAX_STEPS=12
# Бюджет агента. Пусто — по умолчанию: локальная модель 6 поисков и 6000 символов наблюдения, без подсказок;
# облачная — 12 поисков, 14000 символов и подсказки о языке и полноте ответа (в prompt_hash не входят).
MAX_RESEARCH_CALLS=
MAX_OBSERVATION_CHARS=
ANSWER_HINTS=
# Сколько символов статьи команда read отдаёт модели за один вызов (локальная 9000, облачная 60000).
READ_WINDOW_CHARS=
